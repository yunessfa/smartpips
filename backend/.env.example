# Copy to .env and fill in. All optional for local dev.
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Bearer token lifetime in seconds (default 86400 = 1 day)
TOKEN_TTL_SECONDS=86400

# --- PostgreSQL (optional) ---
# If POSTGRES_DB is set, the app uses Postgres; otherwise it falls back to SQLite.
# POSTGRES_DB=smartpips
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Optional: prefill a DeepSeek key (otherwise add it on the AI page)
GROQ_API_KEY=
DEEPSEEK_API_KEY=
