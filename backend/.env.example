# Copy to .env and fill in. All optional for local dev.
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Bearer token lifetime in seconds (default 86400 = 1 day)
TOKEN_TTL_SECONDS=86400

# --- PostgreSQL (optional) ---
# If POSTGRES_DB is set, the app uses Postgres; otherwise it falls back to SQLite.
# POSTGRES_DB=smartpips
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Optional: prefill a DeepSeek key (otherwise add it on the AI page)
# Optional: live metal prices via iTick (https://itick.org). Without it, gold-api.com (no key) is used.
ITICK_TOKEN=

# Optional: real OHLC candles for the scalp strategy engine (https://twelvedata.com, free tier)
TWELVEDATA_KEY=

GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Web Push (scalp alerts). Generate with: python manage.py gen_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@smartpips.ir

# MT5 EA bridge shared secret (any long random string; must match the EA's BridgeKey)
MT5_BRIDGE_KEY=

# cTrader Open API
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_HOST=demo.ctraderapi.com
CTRADER_REDIRECT_URI=https://smartpips.ir/api/ctrader/callback/
CTRADER_GOLD_SYMBOL=XAUUSD
CTRADER_SILVER_SYMBOL=XAGUSD

# LBank real spot account (optional — leave blank to keep Demo mode only)
LBANK_API_KEY=
LBANK_SECRET_KEY=
LBANK_BASE_URL=https://api.lbkex.com
LBANK_SIGN_METHOD=HmacSHA256

# Renewable per-device login. Existing users need one new login to obtain the cookie.
REFRESH_TTL_SECONDS=2592000
# MUST be True behind HTTPS in production. False is for local HTTP development only.
# REFRESH_COOKIE_SECURE=True
# Optional: short-lived access (seconds); refresh cookie keeps the user signed in.
# TOKEN_TTL_SECONDS=1800
# Same-origin deployment is required (/api proxied to Django).
# HTTPS behind a trusted reverse proxy that sets X-Forwarded-Proto:
# USE_PROXY_SSL_HEADER=True
# CSRF_TRUSTED_ORIGINS=https://your-domain.example,https://www.your-domain.example
# Do not disable CSRF/Secure cookies to work around a production proxy error.
# ECONOMIC_CALENDAR_URL expects timestamp WITH timezone, impact, title, currency.
