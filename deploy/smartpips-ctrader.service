[Unit]
Description=SmartPips cTrader bridge (live data + trade execution)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/smartpips/backend
EnvironmentFile=/var/www/smartpips/backend/.env
ExecStart=/var/www/smartpips/backend/.venv/bin/python manage.py ctrader_bridge
Restart=always
RestartSec=5
StandardOutput=append:/var/log/smartpips_ctrader.log
StandardError=append:/var/log/smartpips_ctrader.log

[Install]
WantedBy=multi-user.target
