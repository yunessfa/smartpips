# Copy to /var/www/smartpips/backend/.env and fill in real values.

# Generate a strong key once, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=PASTE_A_LONG_RANDOM_STRING_HERE
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=smartpips.ir,www.smartpips.ir,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://smartpips.ir,https://www.smartpips.ir
USE_PROXY_SSL_HEADER=True

# Token lifetime (1 day)
TOKEN_TTL_SECONDS=86400

# PostgreSQL (recommended in production)
POSTGRES_DB=smartpips
POSTGRES_USER=smartpips
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# AI model key (keeps it out of the source). Used by `manage.py seed`.
GROQ_API_KEY=paste-your-groq-api-key-here

# Same-origin in production, so CORS isn't needed; leave a harmless default.
CORS_ALLOWED_ORIGINS=https://smartpips.ir
