# /etc/systemd/system/gunicorn.service
[Unit]
Description=SmartPips Gunicorn (Django)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/smartpips/backend
Environment="PATH=/var/www/smartpips/backend/.venv/bin"
EnvironmentFile=/var/www/smartpips/backend/.env
ExecStart=/var/www/smartpips/backend/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    --timeout 120 \
    config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
